# ===== Bắt buộc =====
GEMINI_API_KEY=your_gemini_api_key

# ===== Server =====
PORT=8188
NODE_ENV=production
# Port trên VPS mà docker-compose map vào container
HOST_PORT=8188
# Số reverse proxy đứng trước app (Nginx = 1, Cloudflare + Nginx = 2)
TRUST_PROXY=1
# URL public, dùng để hiển thị trong Swagger (vd: https://color.example.com)
PUBLIC_URL=

# ===== Gemini =====
GEMINI_ANALYSIS_MODEL=gemini-2.5-pro
GEMINI_TRANSLATION_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=120000

# ===== Upload =====
MAX_FILE_SIZE_MB=10

# ===== Bảo mật =====
# "*" hoặc danh sách origin phân tách bằng dấu phẩy
CORS_ORIGINS=*
# Để trống = không yêu cầu; nếu đặt, client phải gửi header x-api-key
API_KEY=
# Số request /analyze tối đa mỗi IP trong mỗi window (0 = tắt)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_ANALYZE_MAX=10
